# Canonical origin (overrides site.config.ts url), e.g. https://www.client.gr.
# Prerendered pages bake this in at build time — also pass it as a Docker build arg.
SITE_URL=

# Server timezone: blog/catalog publish times and booking slots use it.
TZ=Europe/Athens
# Set to true on staging to send noindex headers + disallow-all robots.txt
NOINDEX=false

# libSQL: file:./data/site.db (single replica + volume) or libsql://host (sqld/Turso)
DATABASE_URL=file:./data/site.db
DATABASE_AUTH_TOKEN=
# Apply pending migrations on the first request. Set false with multiple replicas
# on a shared libSQL server and run `npm run db:migrate` as a one-off job instead.
DB_MIGRATE_ON_START=true

# Uploaded media directory (mount a persistent volume here in production)
UPLOADS_DIR=./data/uploads

# Allows creating the first admin at /admin/setup while no users exist (16+ random chars).
# Remove it once the owner account exists.
ADMIN_SETUP_TOKEN=

# Resend (optional): notification emails for leads/bookings.
# EMAIL_FROM must be on a domain verified in Resend, e.g. "Acme <no-reply@acme.gr>".
RESEND_API_KEY=
EMAIL_FROM=

# Shop backends: `shopify: true`, or `wordpress: true` with `shop: true` (WooCommerce).
#
# Shopify (module "shopify"). Create a headless storefront: Shopify admin → Sales channels →
# Headless → Storefront API. Unset in `npm run dev` = demo data from mock.shop
# (SHOPIFY_STORE_DOMAIN=mock.shop does the same in production for a demo).
SHOPIFY_STORE_DOMAIN=
# Public token works; the private token (server-only) gets per-buyer rate limits.
SHOPIFY_STOREFRONT_TOKEN=
SHOPIFY_STOREFRONT_PRIVATE_TOKEN=
SHOPIFY_API_VERSION=2025-07
# Webhooks → https://<site>/api/shopify/webhook, JSON, for products/*, collections/*
# and inventory_levels/update. Register them with `npm run shopify:webhooks` (then this
# secret is the app's client secret below) or by hand in Settings → Notifications →
# Webhooks (then it is the signing secret printed at the bottom of that page).
SHOPIFY_WEBHOOK_SECRET=

# Import-time only — used by `npm run shopify:*` to write the catalogue through the
# Admin API. Never set these on the server: serving the shop does not need them and
# the admin token can rewrite the whole catalogue.
# Dev Dashboard → your app → App settings → Credentials.
SHOPIFY_APP_CLIENT_ID=
SHOPIFY_APP_CLIENT_SECRET=
# Written by `npm run shopify:oauth`; do not paste one here by hand.
SHOPIFY_ADMIN_TOKEN=

# WordPress (module "wordpress": content, plugins, and the WooCommerce shop with shop: true).
# `npm run wp:up` starts a local one and prints both values. Only public APIs are used, so
# there are no API keys. WORDPRESS_URL is also read at BUILD time (image CSP, checkout
# redirects): pass it as a Docker build arg too.
WORDPRESS_URL=
# Same value as HEADLESS_WEBHOOK_SECRET in WordPress's wp-config.php (headless bridge plugin):
# publishing in wp-admin clears the site's cache.
WORDPRESS_WEBHOOK_SECRET=
# When WordPress uploads are served from another origin (CDN / offload plugin).
WORDPRESS_MEDIA_URL=
# Default target for `npm run wp:plugins` / `npm run wp` instead of the local Docker WordPress.
WORDPRESS_SSH=
