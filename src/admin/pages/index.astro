---
import { useTranslations } from "@/i18n";
import AdminLayout from "@/admin/layouts/AdminLayout.astro";
import Panel from "@/admin/components/Panel.astro";
import ModuleSlot from "@/components/modules/ModuleSlot.astro";

const t = useTranslations(Astro.locals.lang);
const user = Astro.locals.user!;
---

<AdminLayout title={t("admin.dashboard.title")} description={t("admin.dashboard.welcome", { name: user.name })}>
  <div class="grid gap-6 md:grid-cols-2 xl:grid-cols-3">
    <ModuleSlot name="admin.dashboard">
      <Panel slot="fallback" class="md:col-span-2 xl:col-span-3">
        <p class="text-muted-foreground">{t("admin.dashboard.empty")}</p>
      </Panel>
    </ModuleSlot>
  </div>
</AdminLayout>
