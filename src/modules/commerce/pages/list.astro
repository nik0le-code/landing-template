---
/**
 * All products, a collection (/collections/[collection]) or search results (?q=).
 * Every state lives in the URL, so each is cached separately and invalidated by
 * the backend's webhook.
 */
import { siteConfig } from "@site-config";
import { translateModule } from "@/modules/registry";
import PageLayout from "@/layouts/PageLayout.astro";
import Section from "@/components/ui/Section.astro";
import SectionHeading from "@/components/ui/SectionHeading.astro";
import SlidersHorizontal from "@lucide/astro/icons/sliders-horizontal";
import X from "@lucide/astro/icons/x";
import Button from "@/components/ui/Button.astro";
import Input from "@/components/ui/Input.astro";
import Select from "@/components/ui/Select.astro";
import FilterSidebar from "../components/FilterSidebar.astro";
import ShopTransitions from "../components/ShopTransitions.astro";
import Pagination from "../components/Pagination.astro";
import ProductGrid from "../components/ProductGrid.astro";
import type { SortOption } from "../options";
import { collectionPath, commerceOptions, formatMoney, shopPath } from "../lib/format";
import { withoutFilter, withPrice } from "../lib/listing-url";
import { COMMERCE_CACHE_TAG, listingQuery, resolveSort } from "../lib/products";
import { getCommerce } from "../lib/provider";
import type { Collection, ListingKind, ProductConnection } from "../lib/types";

export const prerender = false;

const lang = Astro.locals.lang;
const t = (key: string, params?: Record<string, string>) => translateModule(lang, "commerce", key, params);
const params = Astro.url.searchParams;
const handle = Astro.params.collection;
const term = (params.get("q") ?? "").trim().slice(0, 100);
const kind: ListingKind = handle ? "collection" : term ? "search" : "all";

const priceMin = params.get("price_min")?.match(/^\d+(\.\d+)?$/)?.[0] ?? "";
const priceMax = params.get("price_max")?.match(/^\d+(\.\d+)?$/)?.[0] ?? "";
const activeFilters = params.getAll("filter").slice(0, 30);
const filterInputs = [
  ...activeFilters,
  ...(priceMin || priceMax ? [JSON.stringify({ price: { ...(priceMin && { min: Number(priceMin) }), ...(priceMax && { max: Number(priceMax) }) } })] : []),
];

let connection: ProductConnection | null = null;
let collection: Collection | null = null;
let collections: Collection[] = [];
let sorts: readonly SortOption[] = [];
let sort: SortOption = "featured";
let failed = false;

try {
  const commerce = await getCommerce();
  sorts = commerce.sorts[kind];
  sort = resolveSort(commerce, kind, params.get("sort"));
  const query = listingQuery({ lang, sort, after: params.get("after"), before: params.get("before"), filters: filterInputs });
  const [result, allCollections] = await Promise.all([
    kind === "collection" ? commerce.getCollection(handle!, query) : kind === "search" ? commerce.searchProducts(term, query) : commerce.listProducts(query),
    commerce.listCollections(lang).catch(() => []),
  ]);
  collections = allCollections;
  if (kind === "collection") {
    if (!result) return Astro.rewrite("/404");
    ({ collection, connection } = result as { collection: Collection; connection: ProductConnection });
  } else {
    connection = result as ProductConnection;
  }
} catch (error) {
  console.error("[commerce] listing:", error);
  failed = true;
  Astro.response.status = 503;
  Astro.response.headers.set("Retry-After", "60");
}

const basePath = shopPath(lang);
const action = collection ? collectionPath(lang, collection.handle) : basePath;
const title = collection ? collection.title : term ? t("list.searchTitle", { term }) : t("list.title");
const description = collection?.seo.description || collection?.description || t("list.description");
const products = connection?.products ?? [];
const filters = connection?.filters ?? [];
const filtered = filterInputs.length > 0 || Boolean(params.get("after") || params.get("before"));
const activeCount = activeFilters.length + (priceMin || priceMax ? 1 : 0);
const currency = products[0]?.price.currencyCode ?? "EUR";

/** Labels for the removable chips above the grid, taken from Shopify's own filter values. */
const labelFor = (input: string) => filters.flatMap((f) => f.values).find((v) => v.input === input)?.label ?? null;
const activeChips = [
  ...activeFilters.flatMap((input) => {
    const label = labelFor(input);
    return label ? [{ label, href: withoutFilter(Astro.url, input) }] : [];
  }),
  ...(priceMin || priceMax
    ? [
        {
          label: [priceMin && formatMoney({ amount: priceMin, currencyCode: currency }, lang), priceMax && formatMoney({ amount: priceMax, currencyCode: currency }, lang)]
            .filter(Boolean)
            .join(" - "),
          href: withPrice(Astro.url),
        },
      ]
    : []),
];
const formId = "shop-listing";
const hasSidebar = collections.length > 0 || filters.length > 0;

if (!failed) Astro.cache.set({ maxAge: commerceOptions().cacheSeconds, swr: 3600, tags: [COMMERCE_CACHE_TAG] });
---

<PageLayout
  seo={{
    title: collection?.seo.title || title,
    description,
    image: collection?.image?.url,
    // Search results and filtered/paged variants shouldn't compete with the listing itself.
    noindex: kind === "search" || filtered || failed,
    alternates: Object.fromEntries(siteConfig.locales.map((l) => [l, collection ? collectionPath(l, collection.handle) : shopPath(l)])),
  }}
  breadcrumbs={[{ name: t("list.title"), path: basePath }, ...(collection ? [{ name: collection.title, path: action }] : [])]}
>
  <ShopTransitions />
  <Section spacing="sm">
    <SectionHeading tag="h1" title={title} description={collection ? collection.description || undefined : t("list.description")} align="left" />

    <form id={formId} method="GET" action={action} data-listing-form></form>

    <div data-product-listing class={hasSidebar ? "mt-10 lg:grid lg:grid-cols-12 lg:gap-10" : "mt-10"}>
      {
        hasSidebar && (
          <div class="lg:col-span-3">
            <FilterSidebar
              lang={lang}
              formId={formId}
              url={Astro.url}
              basePath={basePath}
              collectionPath={(handle) => collectionPath(lang, handle)}
              collections={collections}
              currentCollection={collection?.handle ?? null}
              filters={filters}
              activeFilters={activeFilters}
              priceMin={priceMin}
              priceMax={priceMax}
              currency={currency}
              activeCount={activeCount}
            />
          </div>
        )
      }

      <div class={hasSidebar ? "lg:col-span-9" : undefined}>
        <div class="flex flex-wrap items-end gap-3">
          {
            hasSidebar && (
              <Button variant="outline" popovertarget="shop-filters-panel" class="lg:hidden" data-press>
                <SlidersHorizontal aria-hidden="true" />
                {t("list.filters")}
                {activeCount > 0 && <span class="text-muted-foreground tabular-nums">({activeCount})</span>}
              </Button>
            )
          }
          {
            kind !== "collection" && (
              <div class="min-w-48 flex-1">
                <label for="shop-search" class="sr-only">{t("list.search")}</label>
                <Input id="shop-search" type="search" name="q" form={formId} value={term} placeholder={t("list.searchPlaceholder")} maxlength={100} />
              </div>
            )
          }
          <div class="ml-auto flex items-end gap-2">
            <label for="shop-sort" class="pb-3 text-sm whitespace-nowrap text-muted-foreground">{t("list.sortBy")}</label>
            <Select id="shop-sort" name="sort" form={formId} data-auto-submit data-default={sorts[0]} class="min-w-44">
              {sorts.map((value) => (
                <option value={value} selected={value === sort}>
                  {t(`sort.${kind === "search" && value === "featured" ? "relevance" : value}`)}
                </option>
              ))}
            </Select>
            <Button type="submit" form={formId} variant="outline" data-no-js-only>{t("list.apply")}</Button>
          </div>
        </div>

        {
          activeChips.length > 0 && (
            <ul class="mt-5 flex flex-wrap items-center gap-2" aria-label={t("filters.active")}>
              {activeChips.map((chip) => (
                <li>
                  <a
                    href={chip.href}
                    data-press
                    class="inline-flex items-center gap-1.5 rounded-md bg-muted py-1 pr-2 pl-3 text-[0.8125rem] transition-colors hover:bg-secondary"
                  >
                    {chip.label}
                    <X class="size-3.5 text-muted-foreground" aria-hidden="true" />
                    <span class="sr-only">{t("filters.remove")}</span>
                  </a>
                </li>
              ))}
            </ul>
          )
        }

        {
          failed || products.length === 0 ? (
            <div class="mt-8 flex flex-col items-center gap-4 border border-border bg-card px-6 py-14 text-center">
              <span class="grid size-14 place-items-center rounded-full bg-muted text-muted-foreground">
                <SlidersHorizontal class="size-6" aria-hidden="true" />
              </span>
              <p class="font-medium">{failed ? t("errors.backend") : term || filterInputs.length ? t("list.noResults") : t("list.empty")}</p>
              {!failed && (term || activeCount > 0) && (
                <Button href={action} variant="outline" size="sm">
                  {t("filters.reset")}
                </Button>
              )}
            </div>
          ) : (
            <div class="mt-6">
              <h2 class="sr-only">{t("list.products")}</h2>
              <ProductGrid products={products} lang={lang} headingTag="h3" priorityCount={2} columns={hasSidebar ? 3 : 4} />
              <Pagination lang={lang} pageInfo={connection!.pageInfo} url={Astro.url} />
            </div>
          )
        }
      </div>
    </div>
  </Section>
</PageLayout>

<script>
  for (const form of document.querySelectorAll<HTMLFormElement>("[data-listing-form]")) {
    const fields = () => [...document.querySelectorAll<HTMLInputElement | HTMLSelectElement>(`[form="${form.id}"]`)];
    for (const button of document.querySelectorAll<HTMLElement>("[data-no-js-only]")) button.hidden = true;

    form.addEventListener("submit", () => {
      // Empty fields, and a price slider at its maximum ("no limit"), would only add noise to the cache-keyed URL.
      for (const field of fields()) {
        const noLimit = field instanceof HTMLInputElement && field.type === "range" && Number(field.value) >= Number(field.max);
        const isDefault = field.dataset.default !== undefined && field.value === field.dataset.default;
        if (field.name && !field.disabled && (field.value === "" || noLimit || isDefault)) {
          field.disabled = true;
          field.dataset.submitDisabled = "";
        }
      }
    });

    // Coming back from the back/forward cache, the fields must be usable again.
    addEventListener("pageshow", () => {
      for (const field of document.querySelectorAll<HTMLInputElement | HTMLSelectElement>("[data-submit-disabled]")) {
        field.disabled = false;
        delete field.dataset.submitDisabled;
      }
    });

    document.addEventListener("change", (event) => {
      const target = event.target as HTMLElement;
      if (!target.matches("[data-auto-submit]") || target.getAttribute("form") !== form.id) return;
      // In the mobile drawer, choices are applied together with "Show products".
      if (target.closest(":popover-open")) return;
      form.requestSubmit();
    });
  }
</script>
