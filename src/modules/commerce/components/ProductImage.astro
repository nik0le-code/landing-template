---
/** Responsive product image; the backend supplies the srcset (Shopify CDN widths, WordPress sizes). */
import { cn } from "@/lib/cn";
import type { CommerceImage } from "../lib/types";

interface Props {
  image: CommerceImage;
  alt?: string;
  sizes: string;
  /** The page's LCP image: eager + high fetch priority. */
  priority?: boolean;
  class?: string;
}

const { image, alt, sizes, priority = false, class: className } = Astro.props;
---

<img
  src={image.url}
  srcset={image.srcset ?? undefined}
  sizes={image.srcset ? sizes : undefined}
  alt={alt ?? image.altText ?? ""}
  width={image.width ?? undefined}
  height={image.height ?? undefined}
  loading={priority ? "eager" : "lazy"}
  fetchpriority={priority ? "high" : undefined}
  decoding="async"
  class={cn("bg-muted object-cover", className)}
/>
