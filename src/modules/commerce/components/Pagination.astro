---
import type { Locale } from "@site-config";
import { translateModule } from "@/modules/registry";
import Button from "@/components/ui/Button.astro";
import type { PageInfo } from "../lib/types";

interface Props {
  lang: Locale;
  pageInfo: PageInfo;
  /** Current URL; cursors replace `after`/`before`, other parameters are kept. */
  url: URL;
}

const { lang, pageInfo, url } = Astro.props;
const t = (key: string) => translateModule(lang, "commerce", key);

const withCursor = (key: "after" | "before", cursor: string | null) => {
  const next = new URL(url);
  next.searchParams.delete("after");
  next.searchParams.delete("before");
  if (cursor) next.searchParams.set(key, cursor);
  return next.pathname + next.search;
};
---

{
  (pageInfo.previousCursor || pageInfo.nextCursor) && (
    <nav aria-label={t("list.pagination")} class="mt-12 flex items-center justify-between gap-4 border-t border-border pt-6">
      {pageInfo.previousCursor ? (
        <Button href={withCursor("before", pageInfo.previousCursor)} variant="outline" rel="prev">
          ← {t("list.previous")}
        </Button>
      ) : (
        <span />
      )}
      {pageInfo.nextCursor && (
        <Button href={withCursor("after", pageInfo.nextCursor)} variant="outline" rel="next">
          {t("list.next")} →
        </Button>
      )}
    </nav>
  )
}
