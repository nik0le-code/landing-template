---
import { translateModule } from "@/modules/registry";
import Panel from "@/admin/components/Panel.astro";
import { countPosts } from "../lib/posts";

const tm = (key: string) => translateModule(Astro.locals.lang, "blog", key);
const counts = await countPosts();
---

<Panel title={tm("title")}>
  <p class="text-3xl font-bold">{counts.published ?? 0} <span class="text-sm font-normal text-muted-foreground">{tm("admin.publishedCount")}</span></p>
  <p class="text-sm text-muted-foreground">{counts.draft ?? 0} {tm("admin.draftsCount")}</p>
  <a href="/admin/blog/new" class="mt-3 inline-block text-sm text-primary">{tm("admin.newPost")} →</a>
</Panel>
