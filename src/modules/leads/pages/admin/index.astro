---
import Download from "@lucide/astro/icons/download";
import { localeRegions } from "@/i18n";
import { translateModule } from "@/modules/registry";
import AdminLayout from "@/admin/layouts/AdminLayout.astro";
import Panel from "@/admin/components/Panel.astro";
import Button from "@/components/ui/Button.astro";
import Input from "@/components/ui/Input.astro";
import Select from "@/components/ui/Select.astro";
import StatusBadge from "../../components/StatusBadge.astro";
import { listLeads } from "../../lib/queries";
import { leadsOptions } from "../../lib/submit";
import { LEAD_STATUSES } from "../../options";

const lang = Astro.locals.lang;
const tm = (key: string) => translateModule(lang, "leads", key);

const params = Astro.url.searchParams;
const filters = {
  status: (LEAD_STATUSES as readonly string[]).includes(params.get("status") ?? "") ? params.get("status")! : "",
  form: params.get("form") ?? "",
  query: (params.get("q") ?? "").slice(0, 100),
};
const page = Math.max(1, Number(params.get("page")) || 1);
const pageSize = 25;
const { items, total } = await listLeads(filters, page, pageSize);
const pages = Math.max(1, Math.ceil(total / pageSize));
const forms = Object.keys(leadsOptions().forms);

const query = (extra: Record<string, string>) =>
  new URLSearchParams(Object.fromEntries(Object.entries({ status: filters.status, form: filters.form, q: filters.query, ...extra }).filter(([, v]) => v)));
const formatDate = (date: Date) => new Intl.DateTimeFormat(localeRegions[lang], { dateStyle: "medium", timeStyle: "short" }).format(date);
---

<AdminLayout title={tm("title")} description={tm("description")}>
  <Button slot="actions" variant="outline" href={`/admin/leads/export?${query({})}`}><Download /> {tm("admin.export")}</Button>

  <form method="GET" class="mb-6 grid gap-3 sm:grid-cols-[1fr_12rem_12rem_auto]">
    <Input id="leads-q" name="q" type="search" value={filters.query} placeholder={tm("admin.search")} aria-label={tm("admin.search")} />
    <Select id="leads-status" name="status" aria-label={tm("admin.status")}>
      <option value="">{tm("admin.all")}</option>
      {LEAD_STATUSES.map((status) => <option value={status} selected={filters.status === status}>{tm(`statuses.${status}`)}</option>)}
    </Select>
    <Select id="leads-form" name="form" aria-label={tm("admin.form")}>
      <option value="">{tm("admin.allForms")}</option>
      {forms.map((form) => <option value={form} selected={filters.form === form}>{form}</option>)}
    </Select>
    <Button type="submit" variant="secondary">{tm("admin.filter")}</Button>
  </form>

  {
    items.length === 0 ? (
      <Panel><p class="text-muted-foreground">{tm("admin.empty")}</p></Panel>
    ) : (
      <div class="relative overflow-x-auto rounded-lg border border-border bg-card">
        <table class="w-full text-left text-sm">
          <thead class="border-b border-border bg-muted/50 text-xs uppercase tracking-wide text-muted-foreground">
            <tr>
              <th class="px-4 py-3 font-medium">{tm("fields.name")}</th>
              <th class="px-4 py-3 font-medium">{tm("fields.message")}</th>
              <th class="px-4 py-3 font-medium">{tm("admin.form")}</th>
              <th class="px-4 py-3 font-medium">{tm("admin.status")}</th>
              <th class="px-4 py-3 font-medium">{tm("admin.received")}</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-border">
            {items.map((lead) => (
              <tr class={lead.status === "new" ? "font-medium" : ""}>
                <td class="px-4 py-3">
                  <a href={`/admin/leads/${lead.id}`} class="hover:text-primary">{lead.name || lead.email || "—"}</a>
                  {lead.name && lead.email && <p class="font-normal text-muted-foreground">{lead.email}</p>}
                </td>
                <td class="max-w-sm px-4 py-3 font-normal text-muted-foreground"><p class="line-clamp-2">{lead.message ?? ""}</p></td>
                <td class="px-4 py-3 font-normal">{lead.form}</td>
                <td class="px-4 py-3"><StatusBadge status={lead.status} /></td>
                <td class="px-4 py-3 font-normal whitespace-nowrap text-muted-foreground">{formatDate(lead.createdAt)}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    )
  }

  {
    pages > 1 && (
      <nav class="mt-6 flex items-center justify-between text-sm">
        {page > 1 ? <Button href={`/admin/leads?${query({ page: String(page - 1) })}`} variant="outline" size="sm">← {tm("admin.previous")}</Button> : <span />}
        <span class="text-muted-foreground">{page} / {pages}</span>
        {page < pages ? <Button href={`/admin/leads?${query({ page: String(page + 1) })}`} variant="outline" size="sm">{tm("admin.next")} →</Button> : <span />}
      </nav>
    )
  }
</AdminLayout>
