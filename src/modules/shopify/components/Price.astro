---
import type { Locale } from "@site-config";
import { translateModule } from "@/modules/registry";
import { cn } from "@/lib/cn";
import { formatMoney, isDiscounted } from "../lib/format";
import type { Money } from "../lib/types";

interface Props {
  price: Money;
  compareAt?: Money | null;
  /** Prefix "from" (products whose variants have different prices). */
  from?: boolean;
  lang: Locale;
  class?: string;
}

const { price, compareAt, from = false, lang, class: className } = Astro.props;
const t = (key: string) => translateModule(lang, "shopify", key);
const discounted = isDiscounted(price, compareAt);
---

<p class={cn("flex flex-wrap items-baseline gap-x-2 tabular-nums", className)}>
  <span data-price>{from && <span class="text-muted-foreground">{t("from")} </span>}{formatMoney(price, lang)}</span>
  <s data-compare-at class="text-sm text-muted-foreground" hidden={!discounted}>
    <span class="sr-only">{t("was")} </span><span data-compare-amount>{discounted && formatMoney(compareAt, lang)}</span>
  </s>
</p>
