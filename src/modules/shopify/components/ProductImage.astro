---
/** Responsive image from Shopify's CDN (resized and format-negotiated there). */
import { cn } from "@/lib/cn";
import { imageSrcset, imageUrl } from "../lib/format";
import type { ShopifyImage } from "../lib/types";

interface Props {
  image: ShopifyImage;
  alt?: string;
  sizes: string;
  /** The page's LCP image: eager + high fetch priority. */
  priority?: boolean;
  class?: string;
}

const { image, alt, sizes, priority = false, class: className } = Astro.props;
---

<img
  src={imageUrl(image, 800)}
  srcset={imageSrcset(image)}
  sizes={sizes}
  alt={alt ?? image.altText ?? ""}
  width={image.width ?? undefined}
  height={image.height ?? undefined}
  loading={priority ? "eager" : "lazy"}
  fetchpriority={priority ? "high" : undefined}
  decoding="async"
  class={cn("bg-muted object-cover", className)}
/>
