---
/**
 * The listing's filter rail (after the Xristos store's FacetSidebar): collections,
 * Shopify Search & Discovery filters as swatches or chips, and a price slider with
 * presets. Desktop: a sticky column. Mobile: the same element opens as a drawer
 * (native popover), so there is one set of inputs and it works without JavaScript.
 *
 * Everything is a field of the surrounding GET form (`form` attribute), so every
 * state is a URL. Filter values are Shopify's own `input` JSON, passed back as is.
 */
import type { Locale } from "@site-config";
import Check from "@lucide/astro/icons/check";
import X from "@lucide/astro/icons/x";
import { translateModule } from "@/modules/registry";
import Button from "@/components/ui/Button.astro";
import { cn } from "@/lib/cn";
import { formatMoney } from "../lib/format";
import { listingHref, priceBounds, withPrice } from "../lib/listing-url";
import type { Collection, ProductFilter } from "../lib/types";

interface Props {
  lang: Locale;
  formId: string;
  url: URL;
  basePath: string;
  collectionPath: (handle: string) => string;
  collections: Collection[];
  currentCollection: string | null;
  filters: ProductFilter[];
  activeFilters: string[];
  priceMin: string;
  priceMax: string;
  currency: string;
  activeCount: number;
}

const { lang, formId, url, basePath, collectionPath, collections, currentCollection, filters, activeFilters, priceMin, priceMax, currency, activeCount } =
  Astro.props;
const t = (key: string, params?: Record<string, string | number>) => translateModule(lang, "shopify", key, params);
const active = new Set(activeFilters);
const money = (amount: number) => formatMoney({ amount: String(amount), currencyCode: currency }, lang);

const groups = filters.filter((filter) => filter.type !== "PRICE_RANGE" && filter.values.length > 0);
const bounds = priceBounds(filters.find((filter) => filter.type === "PRICE_RANGE")?.values[0]?.input);
const sliderValue = priceMax ? Number(priceMax) : bounds?.max;
const presets = bounds
  ? (() => {
      const span = bounds.max - bounds.min;
      const round = (value: number) => Math.max(1, Math.round(value / 10) * 10);
      const [t1, t2] = [round(bounds.min + span * 0.33), round(bounds.min + span * 0.66)];
      return [
        { label: t("filters.allPrices"), min: undefined, max: undefined },
        { label: t("filters.upTo", { price: money(t1) }), min: undefined, max: t1 },
        { label: `${money(t1)} - ${money(t2)}`, min: t1, max: t2 },
        { label: `${money(t2)}+`, min: t2, max: undefined },
      ];
    })()
  : [];
const presetActive = (min?: number, max?: number) => (priceMin ? Number(priceMin) : undefined) === min && (priceMax ? Number(priceMax) : undefined) === max;

const heading = "text-[0.6875rem] font-medium tracking-[0.14em] text-muted-foreground uppercase";
const railLink =
  "flex w-full items-center justify-between rounded-md px-3 py-2 text-left text-sm text-muted-foreground transition-colors hover:bg-muted hover:text-foreground aria-[current]:bg-muted aria-[current]:font-medium aria-[current]:text-foreground";
const clearHref = listingHref(url, (params) => ["filter", "price_min", "price_max"].forEach((key) => params.delete(key)));
---

<aside
  id="shop-filters-panel"
  popover
  data-filter-panel
  aria-label={t("list.filters")}
  class="filters-panel m-0 h-dvh max-h-none w-full max-w-xs overflow-y-auto border-r border-border bg-background p-0 text-foreground"
>
  <div class="flex flex-col gap-7 p-6 lg:p-0">
    <header class="flex items-center justify-between gap-3">
      <p class={heading}>{t("list.filters")}</p>
      <div class="flex items-center gap-1">
        {
          activeCount > 0 && (
            <a href={clearHref} class="px-2 py-1 text-xs text-muted-foreground underline underline-offset-2 transition-colors hover:text-foreground">
              {t("filters.clear", { count: activeCount })}
            </a>
          )
        }
        <button
          type="button"
          popovertarget="shop-filters-panel"
          popovertargetaction="hide"
          data-press
          class="-mr-2 inline-flex size-9 items-center justify-center hover:text-accent lg:hidden"
        >
          <X class="size-5" aria-hidden="true" />
          <span class="sr-only">{t("filters.close")}</span>
        </button>
      </div>
    </header>

    {
      collections.length > 0 && (
        <nav aria-label={t("list.collections")} class="flex flex-col gap-2.5">
          <p class={heading}>{t("list.collections")}</p>
          <ul class="flex flex-col gap-0.5">
            <li>
              <a href={basePath} aria-current={currentCollection === null ? "page" : undefined} class={railLink}>
                {t("filters.allCollections")}
              </a>
            </li>
            {collections.map((collection) => (
              <li>
                <a href={collectionPath(collection.handle)} aria-current={currentCollection === collection.handle ? "page" : undefined} class={railLink}>
                  {collection.title}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      )
    }

    {
      groups.map((group) => {
        const swatches = group.values.some((value) => value.swatch?.color);
        return (
          <fieldset class="flex flex-col gap-3">
            <legend class={cn(heading, "mb-3")}>{group.label}</legend>
            <div class={cn("flex flex-wrap", swatches ? "gap-2.5" : "gap-2")}>
              {group.values.map((value) => {
                const checked = active.has(value.input);
                const disabled = value.count === 0 && !checked;
                const input = (
                  <input
                    type="checkbox"
                    name="filter"
                    value={value.input}
                    form={formId}
                    checked={checked}
                    disabled={disabled}
                    data-auto-submit
                    class="peer sr-only"
                  />
                );
                return swatches ? (
                  <label
                    title={`${value.label} (${value.count})`}
                    data-press
                    class={cn(
                      "relative grid size-8 cursor-pointer place-items-center rounded-full ring-1 ring-border transition-shadow hover:ring-foreground/40",
                      "has-[:checked]:ring-2 has-[:checked]:ring-foreground has-[:checked]:ring-offset-2 has-[:checked]:ring-offset-background",
                      "has-[:focus-visible]:outline-2 has-[:focus-visible]:outline-offset-4 has-[:focus-visible]:outline-primary",
                      disabled && "cursor-not-allowed opacity-40",
                    )}
                  >
                    {input}
                    <svg viewBox="0 0 32 32" class="absolute inset-0 size-full" aria-hidden="true">
                      <circle cx="16" cy="16" r="16" fill={value.swatch?.color ?? "currentColor"} class={value.swatch?.color ? undefined : "text-muted"} />
                    </svg>
                    <Check class="relative hidden size-3.5 text-white mix-blend-difference peer-checked:block" stroke-width={3} aria-hidden="true" />
                    <span class="sr-only">
                      {value.label} ({value.count})
                    </span>
                  </label>
                ) : (
                  <label
                    data-press
                    class={cn(
                      "cursor-pointer rounded-md bg-muted px-3 py-1.5 text-[0.8125rem] text-muted-foreground transition-colors hover:text-foreground",
                      "has-[:checked]:bg-card has-[:checked]:font-medium has-[:checked]:text-foreground has-[:checked]:ring-1 has-[:checked]:ring-foreground",
                      "has-[:focus-visible]:outline-2 has-[:focus-visible]:outline-offset-2 has-[:focus-visible]:outline-primary",
                      disabled && "cursor-not-allowed opacity-40",
                    )}
                  >
                    {input}
                    {value.label}
                    <span class="ms-1.5 tabular-nums opacity-55">{value.count}</span>
                  </label>
                );
              })}
            </div>
          </fieldset>
        );
      })
    }

    {
      bounds && (
        <fieldset class="flex flex-col gap-3">
          <div class="flex items-baseline justify-between gap-3">
            <legend class={heading}>{t("list.price")}</legend>
            <output for="shop-price-max" data-price-output data-template={t("filters.upTo", { price: "{price}" })} class="text-[0.8125rem] font-medium tabular-nums">
              {t("filters.upTo", { price: money(sliderValue ?? bounds.max) })}
            </output>
          </div>
          {priceMin && <input type="hidden" name="price_min" value={priceMin} form={formId} />}
          <input
            id="shop-price-max"
            type="range"
            name="price_max"
            form={formId}
            min={bounds.min}
            max={bounds.max}
            step={bounds.max > 1000 ? 50 : bounds.max > 200 ? 10 : 1}
            value={sliderValue}
            data-auto-submit
            data-currency={currency}
            data-locale={lang}
            aria-label={t("filters.maxPrice")}
            class="w-full accent-primary"
          />
          <div class="flex justify-between text-[0.6875rem] text-muted-foreground tabular-nums">
            <span>{money(bounds.min)}</span>
            <span>{money(bounds.max)}</span>
          </div>
          <ul class="flex flex-col gap-1">
            {presets.map((preset) => (
              <li>
                <a
                  href={withPrice(url, preset.min, preset.max)}
                  aria-current={presetActive(preset.min, preset.max) ? "true" : undefined}
                  class="block rounded-md px-3 py-2 text-[0.8125rem] text-muted-foreground transition-colors hover:bg-muted hover:text-foreground aria-[current]:bg-card aria-[current]:font-medium aria-[current]:text-foreground aria-[current]:ring-1 aria-[current]:ring-foreground"
                >
                  {preset.label}
                </a>
              </li>
            ))}
          </ul>
        </fieldset>
      )
    }

    <div class="sticky bottom-0 -mx-6 border-t border-border bg-background p-6 lg:hidden">
      <Button type="submit" form={formId} class="w-full">{t("filters.show")}</Button>
    </div>
    {
      (groups.length > 0 || bounds) && (
        <Button type="submit" form={formId} variant="outline" class="hidden w-full lg:[&:not([hidden])]:inline-flex" data-no-js-only>
          {t("list.apply")}
        </Button>
      )
    }
  </div>
</aside>

<style>
  /* Mobile: a drawer from the left with a spring. */
  .filters-panel {
    translate: -100% 0;
  }
  .filters-panel:popover-open {
    translate: 0 0;
  }
  .filters-panel::backdrop {
    background: oklch(0 0 0 / 0.4);
  }
  @media (prefers-reduced-motion: no-preference) {
    .filters-panel {
      transition:
        translate var(--shop-spring-duration, 0.5s) var(--shop-spring, ease-out),
        overlay 0.3s allow-discrete,
        display 0.3s allow-discrete;
    }
    @starting-style {
      .filters-panel:popover-open {
        translate: -100% 0;
      }
    }
  }

  /* Desktop: the same element is a sticky rail, whatever its popover state. */
  @media (min-width: 64rem) {
    .filters-panel,
    .filters-panel:popover-open {
      position: sticky;
      top: 6.5rem;
      display: block;
      inset: auto;
      translate: none;
      width: auto;
      max-width: none;
      height: auto;
      max-height: calc(100dvh - 8rem);
      overflow-y: auto;
      scrollbar-width: thin;
      padding-right: 0.5rem;
      border: 0;
      background: transparent;
      transition: none;
    }
  }
</style>

<script>
  for (const panel of document.querySelectorAll<HTMLElement>("[data-filter-panel]")) {
    const slider = panel.querySelector<HTMLInputElement>('input[type="range"]');
    const output = panel.querySelector<HTMLOutputElement>("[data-price-output]");
    if (slider && output) {
      const format = new Intl.NumberFormat(slider.dataset.locale, { style: "currency", currency: slider.dataset.currency, maximumFractionDigits: 0 });
      slider.addEventListener("input", () => (output.value = (output.dataset.template ?? "{price}").replace("{price}", format.format(Number(slider.value)))));
    }
  }
</script>
