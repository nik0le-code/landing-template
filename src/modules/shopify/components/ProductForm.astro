---
/**
 * Variant picker + add to cart. Without JavaScript the chosen options are posted
 * and the server resolves the variant; with it the price, availability, image and
 * URL follow the selection immediately.
 */
import type { Locale } from "@site-config";
import { translateModule } from "@/modules/registry";
import Button from "@/components/ui/Button.astro";
import { cn } from "@/lib/cn";
import { MAX_LINE_QUANTITY } from "../lib/cart";
import { formatMoney, isDiscounted, numericId, shopPath } from "../lib/format";
import type { Product, ProductVariant } from "../lib/types";
import CartForm from "./CartForm.astro";

interface Props {
  product: Product;
  selected: ProductVariant | undefined;
  lang: Locale;
}

const { product, selected, lang } = Astro.props;
const t = (key: string) => translateModule(lang, "shopify", key);
const imageIndex = (url: string | undefined) => product.images.nodes.findIndex((image) => image.url === url);

const variants = product.variants.nodes.map((variant) => ({
  id: variant.id,
  key: numericId(variant.id),
  available: variant.availableForSale,
  options: Object.fromEntries(variant.selectedOptions.map((o) => [o.name, o.value])),
  price: formatMoney(variant.price, lang),
  amount: Number(variant.price.amount),
  compareAt: isDiscounted(variant.price, variant.compareAtPrice) ? formatMoney(variant.compareAtPrice, lang) : null,
  image: imageIndex(variant.image?.url),
}));
// "Default Title" is Shopify's placeholder option for products without variants.
const options = product.options.filter((option) => !(option.optionValues.length === 1 && option.optionValues[0]!.name === "Default Title"));
const current = Object.fromEntries(selected?.selectedOptions.map((o) => [o.name, o.value]) ?? []);

/** A value is unavailable when no in-stock variant has it together with the other current choices. */
const isAvailable = (name: string, value: string) =>
  variants.some((v) => v.available && Object.entries({ ...current, [name]: value }).every(([n, val]) => v.options[n] === val));

const available = selected?.availableForSale ?? false;
---

<CartForm
  lang={lang}
  intent="add"
  returnTo={shopPath(lang, product.handle)}
  fields={{ handle: product.handle }}
  class="space-y-6"
  data-product-form
  data-variants={JSON.stringify(variants)}
  data-product-id={product.id}
  data-product-title={product.title}
  data-currency={selected?.price.currencyCode ?? product.priceRange.minVariantPrice.currencyCode}
  data-price={selected?.price.amount ?? product.priceRange.minVariantPrice.amount}
>
  <input type="hidden" name="merchandiseId" value={selected?.id ?? ""} />

  {
    options.map((option) => (
      <fieldset>
        <legend class="text-sm font-medium">
          {option.name}
          <span class="font-normal text-muted-foreground" data-option-current={option.name}>
            {current[option.name] ? `: ${current[option.name]}` : ""}
          </span>
        </legend>
        <div class="mt-3 flex flex-wrap gap-2">
          {option.optionValues.map((value) => (
            <label
              data-press
              data-option-value
              data-unavailable={isAvailable(option.name, value.name) ? undefined : ""}
              class={cn(
                "relative inline-flex min-h-10 min-w-11 cursor-pointer items-center justify-center gap-2 rounded-md border border-border px-3.5 text-sm transition-colors",
                "hover:border-foreground/40 has-[:checked]:border-foreground has-[:checked]:bg-muted has-[:focus-visible]:outline-2 has-[:focus-visible]:outline-offset-2 has-[:focus-visible]:outline-primary",
                "data-[unavailable]:text-muted-foreground data-[unavailable]:line-through",
              )}
            >
              <input type="radio" name={`option:${option.name}`} value={value.name} checked={current[option.name] === value.name} required class="sr-only" />
              {value.swatch?.color && (
                // An SVG fill instead of an inline style: the CSP blocks style attributes.
                <svg viewBox="0 0 16 16" class="size-4" aria-hidden="true">
                  <circle cx="8" cy="8" r="7.5" fill={value.swatch.color} class="stroke-border" />
                </svg>
              )}
              {value.name}
            </label>
          ))}
        </div>
      </fieldset>
    ))
  }

  <p data-cart-message role="alert" class="border border-destructive/30 bg-destructive/10 px-4 py-3 text-sm text-destructive empty:hidden"></p>

  <div class="flex gap-3">
    <label class="sr-only" for={`quantity-${product.handle}`}>{t("cart.quantity")}</label>
    <input
      id={`quantity-${product.handle}`}
      type="number"
      name="quantity"
      value="1"
      min="1"
      max={MAX_LINE_QUANTITY}
      inputmode="numeric"
      class="h-12.5 w-20 rounded-md border border-border bg-card px-3 text-center text-base tabular-nums focus:border-foreground focus:outline-2 focus:outline-foreground/20"
    />
    <Button type="submit" size="lg" class="flex-1" disabled={!available} data-add-label={t("product.addToCart")} data-sold-out-label={t("soldOut")}>
      {available ? t("product.addToCart") : t("soldOut")}
    </Button>
  </div>
</CartForm>

<script>
  interface Variant {
    id: string;
    key: string;
    available: boolean;
    options: Record<string, string>;
    price: string;
    amount: number;
    compareAt: string | null;
    image: number;
  }

  for (const form of document.querySelectorAll<HTMLFormElement>("[data-product-form]")) {
    const variants = JSON.parse(form.dataset.variants ?? "[]") as Variant[];
    const merchandiseId = form.querySelector<HTMLInputElement>('input[name="merchandiseId"]')!;
    const submit = form.querySelector<HTMLButtonElement>('button[type="submit"]')!;
    const root = form.closest("[data-product]") ?? document;

    const choices = () =>
      Object.fromEntries(
        [...form.querySelectorAll<HTMLInputElement>('input[type="radio"]:checked')].map((input) => [input.name.slice("option:".length), input.value]),
      );
    const matches = (variant: Variant, wanted: Record<string, string>) => Object.entries(wanted).every(([name, value]) => variant.options[name] === value);

    form.addEventListener("change", (event) => {
      if (!(event.target instanceof HTMLInputElement) || event.target.type !== "radio") return;
      const current = choices();
      const variant = variants.find((v) => matches(v, current));

      merchandiseId.value = variant?.id ?? "";
      const available = Boolean(variant?.available);
      submit.disabled = !available;
      submit.textContent = (available ? submit.dataset.addLabel : submit.dataset.soldOutLabel) ?? "";
      form.dataset.price = String(variant?.amount ?? "");

      const price = root.querySelector<HTMLElement>("[data-product-price] [data-price]");
      const compareAt = root.querySelector<HTMLElement>("[data-product-price] [data-compare-at]");
      const compareAmount = compareAt?.querySelector<HTMLElement>("[data-compare-amount]");
      if (variant && price) price.textContent = variant.price;
      if (compareAt && compareAmount) {
        compareAt.hidden = !variant?.compareAt;
        compareAmount.textContent = variant?.compareAt ?? "";
      }

      for (const label of form.querySelectorAll<HTMLElement>("[data-option-current]")) {
        const name = label.dataset.optionCurrent!;
        label.textContent = current[name] ? `: ${current[name]}` : "";
      }
      for (const label of form.querySelectorAll<HTMLLabelElement>("[data-option-value]")) {
        const input = label.querySelector("input")!;
        const name = input.name.slice("option:".length);
        const possible = variants.some((v) => v.available && matches(v, { ...current, [name]: input.value }));
        label.toggleAttribute("data-unavailable", !possible);
      }

      if (variant) {
        const url = new URL(location.href);
        url.searchParams.set("variant", variant.key);
        history.replaceState(history.state, "", url);
        if (variant.image >= 0) root.querySelector("[data-gallery]")?.dispatchEvent(new CustomEvent("gallery:show", { detail: variant.image }));
      }
    });
  }
</script>
