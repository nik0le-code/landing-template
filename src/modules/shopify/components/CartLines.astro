---
/** Cart contents, used by the cart page and the drawer (same markup, two densities). */
import type { Locale } from "@site-config";
import Minus from "@lucide/astro/icons/minus";
import Plus from "@lucide/astro/icons/plus";
import { translateModule } from "@/modules/registry";
import Button from "@/components/ui/Button.astro";
import Input from "@/components/ui/Input.astro";
import { cn } from "@/lib/cn";
import { MAX_LINE_QUANTITY } from "../lib/cart";
import { cartPath, formatMoney, isDiscounted, shopPath } from "../lib/format";
import type { Cart } from "../lib/types";
import CartForm from "./CartForm.astro";
import ProductImage from "./ProductImage.astro";

interface Props {
  cart: Cart | null;
  lang: Locale;
  layout: "page" | "drawer";
  /** Error code from a failed change (`?cart_error=`). */
  error?: string | null;
}

const { cart, lang, layout, error } = Astro.props;
const t = (key: string, params?: Record<string, string | number>) => translateModule(lang, "shopify", key, params);
const lines = cart?.lines.nodes ?? [];
const returnTo = cartPath(lang);
const compact = layout === "drawer";
const knownErrors = ["invalid", "rateLimited", "unavailable", "notFound", "shopify"];
const stepperButton = "inline-flex size-9 items-center justify-center text-foreground/70 transition-colors hover:text-foreground disabled:pointer-events-none disabled:opacity-40";
---

<div data-cart-lines class={cn("flex flex-col", compact && "h-full")}>
  <p data-cart-message role="alert" class="mb-4 border border-destructive/30 bg-destructive/10 px-4 py-3 text-sm text-destructive empty:hidden">
    {error ? t(`errors.${knownErrors.includes(error) ? error : "shopify"}`) : ""}
  </p>

  {
    lines.length === 0 ? (
      <div class={cn("flex flex-col items-start gap-5", compact ? "py-6" : "py-10")}>
        <p class="text-muted-foreground">{t("cart.empty")}</p>
        <Button href={shopPath(lang)} variant="outline">{t("cart.continue")}</Button>
      </div>
    ) : (
      <>
        <ul class={cn("divide-y divide-border border-y border-border", compact && "flex-1 overflow-y-auto")} aria-label={t("cart.items")}>
          {lines.map((line) => {
            const { merchandise } = line;
            const image = merchandise.image ?? merchandise.product.featuredImage;
            const options = merchandise.selectedOptions.filter((o) => o.value !== "Default Title");
            const maxQuantity = Math.min(MAX_LINE_QUANTITY, merchandise.quantityAvailable ?? MAX_LINE_QUANTITY);
            const fields = { lineId: line.id };
            return (
              <li data-cart-line class="flex gap-4 py-4">
                <a href={shopPath(lang, merchandise.product.handle)} class="shrink-0" tabindex="-1" aria-hidden="true">
                  {image ? (
                    <ProductImage image={image} alt="" sizes={compact ? "4.5rem" : "6rem"} class={cn("aspect-[4/5]", compact ? "w-18" : "w-24")} />
                  ) : (
                    <div class={cn("aspect-[4/5] bg-muted", compact ? "w-18" : "w-24")} />
                  )}
                </a>
                <div class="flex min-w-0 flex-1 flex-col gap-1">
                  <div class="flex items-start justify-between gap-3">
                    <a href={shopPath(lang, merchandise.product.handle)} class="font-medium text-balance hover:underline">
                      {merchandise.product.title}
                    </a>
                    <p class="shrink-0 tabular-nums">{formatMoney(line.cost.totalAmount, lang)}</p>
                  </div>
                  {options.length > 0 && <p class="text-sm text-muted-foreground">{options.map((o) => `${o.name}: ${o.value}`).join(" · ")}</p>}
                  <p class="text-sm text-muted-foreground tabular-nums">
                    {formatMoney(line.cost.amountPerQuantity, lang)}
                    {isDiscounted(line.cost.amountPerQuantity, line.cost.compareAtAmountPerQuantity) && (
                      <s class="ml-1">{formatMoney(line.cost.compareAtAmountPerQuantity, lang)}</s>
                    )}
                  </p>
                  {!merchandise.availableForSale && <p class="text-sm text-destructive">{t("soldOut")}</p>}
                  <div class="mt-auto flex items-center justify-between gap-3 pt-2">
                    <CartForm lang={lang} intent="update" returnTo={returnTo} fields={fields} class="inline-flex items-center border border-border">
                      <button type="submit" name="quantity" value={line.quantity - 1} data-press class={stepperButton} aria-label={t("cart.decrease", { product: merchandise.product.title })}>
                        <Minus class="size-4" aria-hidden="true" />
                      </button>
                      <span class="min-w-8 text-center text-sm tabular-nums"><span class="sr-only">{t("cart.quantity")}: </span>{line.quantity}</span>
                      <button
                        type="submit"
                        name="quantity"
                        value={line.quantity + 1}
                        disabled={line.quantity >= maxQuantity}
                        data-press class={stepperButton}
                        aria-label={t("cart.increase", { product: merchandise.product.title })}
                      >
                        <Plus class="size-4" aria-hidden="true" />
                      </button>
                    </CartForm>
                    <CartForm lang={lang} intent="remove" returnTo={returnTo} fields={fields}>
                      <button type="submit" data-press class="text-sm text-muted-foreground underline-offset-4 hover:text-foreground hover:underline">
                        {t("cart.remove")}
                      </button>
                    </CartForm>
                  </div>
                </div>
              </li>
            );
          })}
        </ul>

        <div class="space-y-4 pt-5">
          {!compact && (
            <div class="space-y-3">
              <CartForm lang={lang} intent="discount" returnTo={returnTo} class="flex gap-2">
                <label for="cart-discount" class="sr-only">{t("cart.discountCode")}</label>
                <Input id="cart-discount" name="code" placeholder={t("cart.discountCode")} autocomplete="off" maxlength={100} class="py-2" />
                <Button type="submit" variant="outline">{t("cart.apply")}</Button>
              </CartForm>
              {cart!.discountCodes.map((discount) => (
                <CartForm lang={lang} intent="discount" returnTo={returnTo} fields={{ code: "" }} class="flex items-center justify-between gap-3 text-sm">
                  <span>
                    <span class="font-mono">{discount.code}</span>{" "}
                    <span class={discount.applicable ? "text-success" : "text-muted-foreground"}>
                      {discount.applicable ? t("cart.discountApplied") : t("cart.discountNotApplicable")}
                    </span>
                  </span>
                  <button type="submit" class="text-muted-foreground underline-offset-4 hover:text-foreground hover:underline">{t("cart.remove")}</button>
                </CartForm>
              ))}
            </div>
          )}
          <dl class="flex items-baseline justify-between gap-4">
            <dt class="font-medium">{t("cart.subtotal")}</dt>
            <dd class="text-lg font-medium tabular-nums">{formatMoney(cart!.cost.subtotalAmount, lang)}</dd>
          </dl>
          <p class="text-sm text-muted-foreground">{t("cart.taxesNote")}</p>
          <Button href={cartPath(lang, "checkout")} size="lg" class="w-full" data-cart-checkout>{t("cart.checkout")}</Button>
          {compact ? (
            <Button href={cartPath(lang)} variant="outline" class="w-full">{t("cart.view")}</Button>
          ) : (
            <a href={shopPath(lang)} class="block text-center text-sm text-muted-foreground underline-offset-4 hover:text-foreground hover:underline">
              {t("cart.continue")}
            </a>
          )}
        </div>
      </>
    )
  }
</div>
