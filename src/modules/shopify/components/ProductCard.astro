---
import type { Locale } from "@site-config";
import { translateModule } from "@/modules/registry";
import Badge from "@/components/ui/Badge.astro";
import Card from "@/components/ui/Card.astro";
import { isDiscounted, shopPath } from "../lib/format";
import type { ProductCardData } from "../lib/types";
import Price from "./Price.astro";
import ProductImage from "./ProductImage.astro";

interface Props {
  product: ProductCardData;
  lang: Locale;
  headingTag?: "h2" | "h3";
  priority?: boolean;
}

const { product, lang, headingTag: Heading = "h2", priority = false } = Astro.props;
const t = (key: string) => translateModule(lang, "shopify", key);
const { minVariantPrice, maxVariantPrice } = product.priceRange;
const onSale = isDiscounted(minVariantPrice, product.compareAtPriceRange.minVariantPrice);
---

<Card
  as="article"
  padding="none"
  interactive
  data-product-card={shopPath(lang, product.handle)}
  data-product-key={product.handle}
  class="group flex h-full flex-col overflow-hidden motion-safe:transition-[border-color,translate] motion-safe:duration-300 motion-safe:hover:-translate-y-1"
>
  <div class="relative aspect-[4/5] overflow-hidden bg-muted">
    {
      product.featuredImage && (
        <ProductImage
          image={product.featuredImage}
          alt=""
          sizes="(min-width: 1280px) 20rem, (min-width: 1024px) 25vw, (min-width: 640px) 33vw, 50vw"
          priority={priority}
          class="size-full transition-transform duration-500 group-hover:scale-105 motion-reduce:transition-none"
        />
      )
    }
    <div class="absolute top-3 left-3 flex gap-1.5">
      {!product.availableForSale && <Badge variant="outline" class="bg-card">{t("soldOut")}</Badge>}
      {product.availableForSale && onSale && <Badge class="bg-card">{t("sale")}</Badge>}
    </div>
  </div>
  <div class="flex flex-1 flex-col gap-1 p-4">
    {product.vendor && <p class="text-xs text-muted-foreground">{product.vendor}</p>}
    <Heading class="text-sm font-medium text-balance sm:text-base">
      <a href={shopPath(lang, product.handle)} class="after:absolute after:inset-0">{product.title}</a>
    </Heading>
    <Price
      price={minVariantPrice}
      compareAt={product.compareAtPriceRange.minVariantPrice}
      from={minVariantPrice.amount !== maxVariantPrice.amount}
      lang={lang}
      class="mt-auto pt-2 text-sm"
    />
  </div>
</Card>
