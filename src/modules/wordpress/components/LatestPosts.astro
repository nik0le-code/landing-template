---
/** Latest WordPress posts (server island on the prerendered home page). */
import type { Locale } from "@site-config";
import { translateModule } from "@/modules/registry";
import Button from "@/components/ui/Button.astro";
import Section from "@/components/ui/Section.astro";
import SectionHeading from "@/components/ui/SectionHeading.astro";
import PostCard from "./PostCard.astro";
import { wordpressOptions } from "../lib/config";
import { listPosts, postsPath, WORDPRESS_CACHE_TAG } from "../lib/content";

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = (key: string) => translateModule(lang, "wordpress", key);
const { latestOnHome, cacheSeconds } = wordpressOptions();
const items = await listPosts({ lang, perPage: latestOnHome })
  .then((result) => result.items)
  .catch((error: unknown) => {
    console.error("[wordpress] latest posts:", error);
    return null;
  });

// Failures aren't cached, so the section comes back as soon as WordPress does.
if (items) Astro.cache.set({ maxAge: cacheSeconds, swr: 3600, tags: [WORDPRESS_CACHE_TAG] });
---

{
  items && items.length > 0 && (
    <Section tone="muted">
      <div class="flex flex-wrap items-end justify-between gap-4">
        <SectionHeading title={t("latest")} description={t("latestDescription")} align="left" />
        <Button href={postsPath(lang)} variant="outline">{t("allPosts")} →</Button>
      </div>
      <ul class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {items.map((post) => (
          <li>
            <PostCard post={post} lang={lang} headingTag="h3" />
          </li>
        ))}
      </ul>
    </Section>
  )
}
