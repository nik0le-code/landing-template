---
/**
 * Pages written in Strapi, at /[lang]/<path>. This is the lowest-priority route:
 * pages in src/pages/ and module routes always win, so it only answers for paths
 * nothing else owns (and 404s when Strapi has no such page either).
 */
import { siteConfig } from "@site-config";
import { translateModule } from "@/modules/registry";
import PageLayout from "@/layouts/PageLayout.astro";
import Prose from "@/components/ui/Prose.astro";
import Section from "@/components/ui/Section.astro";
import StrapiImage from "../components/StrapiImage.astro";
import { strapiOptions } from "../lib/config";
import { getPage, STRAPI_CACHE_TAG, type Page } from "../lib/content";

export const prerender = false;

const lang = Astro.locals.lang;
const unavailable = translateModule(lang, "strapi", "unavailable");
const path = (Astro.params.path ?? "").replace(/\/+$/, "");
// Asset-looking or system paths never are Strapi pages; answer them without a request.
if (!path || /\.[a-z0-9]{2,5}$/i.test(path) || path.split("/").length > 6) return Astro.rewrite("/404");

let page: Page | null = null;
let failure: Response | null = null;
try {
  page = await getPage(path, lang);
} catch (error) {
  console.error("[strapi] page:", error);
  failure = new Response(unavailable, { status: 503, headers: { "Retry-After": "60", "Content-Type": "text/plain; charset=utf-8" } });
}
if (failure) return failure;
if (!page) return Astro.rewrite("/404");

Astro.cache.set({ maxAge: strapiOptions().cacheSeconds, swr: 3600, tags: [STRAPI_CACHE_TAG] });
---

<PageLayout
  seo={{
    title: page.seo.title ?? page.title,
    rawTitle: Boolean(page.seo.title),
    description: page.seo.description ?? siteConfig.description[lang],
    image: page.seo.image ?? page.image?.url,
    noindex: page.seo.noindex,
    alternates: page.alternates,
  }}
  breadcrumbs={[{ name: page.title, path: `/${lang}/${page.path}` }]}
>
  <Section spacing="sm" width="md">
    <h1 class="text-4xl font-medium tracking-tight text-balance sm:text-5xl">{page.title}</h1>
    {page.image && <StrapiImage image={page.image} sizes="(min-width: 1024px) 48rem, 100vw" priority class="mt-10 aspect-[16/9] w-full" />}
    {/* Built from Strapi's rich text JSON (lib/blocks.ts), every string escaped. */}
    <Prose class="mt-10"><Fragment set:html={page.html} /></Prose>
  </Section>
</PageLayout>
