---
import { translateModule } from "@/modules/registry";
import Panel from "@/admin/components/Panel.astro";
import { countItems } from "../lib/items";

const tm = (key: string) => translateModule(Astro.locals.lang, "catalog", key);
const counts = await countItems();
---

<Panel title={tm("admin.items")}>
  <p class="text-3xl font-bold">{counts.published} <span class="text-sm font-normal text-muted-foreground">{tm("admin.publishedCount")}</span></p>
  <p class="text-sm text-muted-foreground">{counts.hidden} {tm("admin.hiddenCount")}</p>
  <a href="/admin/catalog/new" class="mt-3 inline-block text-sm text-primary">{tm("admin.newItem")} →</a>
</Panel>
