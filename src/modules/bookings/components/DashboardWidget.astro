---
import { translateModule } from "@/modules/registry";
import Panel from "@/admin/components/Panel.astro";
import { upcomingCount } from "../lib/availability";

const tm = (key: string) => translateModule(Astro.locals.lang, "bookings", key);
const pending = await upcomingCount();
---

<Panel title={tm("title")}>
  <p class="text-3xl font-bold">{pending}</p>
  <p class="text-sm text-muted-foreground">{tm("admin.pendingCount")}</p>
  <a href="/admin/bookings" class="mt-3 inline-block text-sm text-primary">{tm("admin.title")} →</a>
</Panel>
