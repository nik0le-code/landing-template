---
import PageLayout from "@/layouts/PageLayout.astro";
import Bento, { type BentoItem } from "@/components/sections/Bento.astro";
import Cta from "@/components/sections/Cta.astro";
import Faq from "@/components/sections/Faq.astro";
import FeatureGrid from "@/components/sections/FeatureGrid.astro";
import HeroCentered from "@/components/sections/HeroCentered.astro";
import LogoCloud from "@/components/sections/LogoCloud.astro";
import Pricing, { type Plan } from "@/components/sections/Pricing.astro";
import Stats from "@/components/sections/Stats.astro";
import Steps from "@/components/sections/Steps.astro";
import Testimonials from "@/components/sections/Testimonials.astro";
import type { FeatureItem } from "@/components/sections/types";
import { getDictionary, localeStaticPaths, localizePath } from "@/i18n";
import { organizationSchema, websiteSchema } from "@/lib/seo/schema";
import heroImage from "@/assets/demo/hero.jpg";
import globex from "@/assets/logos/globex.svg";
import hooli from "@/assets/logos/hooli.svg";
import initech from "@/assets/logos/initech.svg";
import northwind from "@/assets/logos/northwind.svg";
import umbrella from "@/assets/logos/umbrella.svg";
import vandelay from "@/assets/logos/vandelay.svg";

// Static content → rendered once at build time (HTML + optimized images on disk).
export const prerender = true;
export const getStaticPaths = () => localeStaticPaths();

const lang = Astro.locals.lang;
const copy = getDictionary(lang).home;
const contactHref = localizePath("/contact", lang);

const logos = [
  { src: northwind, alt: "Northwind" },
  { src: globex, alt: "Globex" },
  { src: initech, alt: "Initech" },
  { src: umbrella, alt: "Umbrella" },
  { src: hooli, alt: "Hooli" },
  { src: vandelay, alt: "Vandelay" },
];

const plans: Plan[] = copy.pricing.plans.map((plan) => ({
  ...plan,
  cta: { label: plan.cta, href: contactHref },
}));
---

<PageLayout seo={{ title: copy.meta.title, description: copy.meta.description }} schema={[organizationSchema(), websiteSchema(lang)]}>
  <HeroCentered
    badge={copy.hero.badge}
    title={copy.hero.title}
    description={copy.hero.description}
    actions={[
      { label: copy.hero.primary, href: contactHref },
      { label: copy.hero.secondary, href: "#how-it-works" },
    ]}
    image={{ src: heroImage, alt: copy.hero.imageAlt }}
  />
  <LogoCloud title={copy.logos.title} logos={logos} />
  <FeatureGrid id="features" {...copy.features} items={copy.features.items as FeatureItem[]} tone="muted" />
  <Bento
    {...copy.bento}
    items={(copy.bento.items as BentoItem[]).map((item) => (item.size === "large" ? { ...item, image: { src: heroImage, alt: "" } } : item))}
  />
  <Steps id="how-it-works" {...copy.steps} steps={copy.steps.items} tone="muted" />
  <Stats items={copy.stats.items} />
  <Testimonials {...copy.testimonials} />
  <Pricing {...copy.pricing} plans={plans} billingLabels={copy.pricing.billing} tone="muted" />
  <Faq {...copy.faq} />
  <Cta
    title={copy.cta.title}
    description={copy.cta.description}
    actions={[
      { label: copy.cta.primary, href: contactHref },
      { label: copy.cta.secondary, href: "#pricing" },
    ]}
  />
</PageLayout>
