---
import PageLayout from "@/layouts/PageLayout.astro";
import Section from "@/components/ui/Section.astro";
import SectionHeading from "@/components/ui/SectionHeading.astro";
import { useTranslations } from "@/i18n";
import { organizationSchema, websiteSchema } from "@/lib/seo/schema";
import { siteConfig } from "@site-config";

const lang = Astro.locals.lang;
const t = useTranslations(lang);

Astro.cache.set({ maxAge: 300, swr: 3600, tags: ["page:home"] });
---

<PageLayout
  seo={{ title: t("meta.home.title"), description: t("meta.home.description") }}
  schema={[organizationSchema(), websiteSchema(lang)]}
>
  <Section lazyRender={false} spacing="lg">
    <SectionHeading tag="h1" title={siteConfig.name} description={t("meta.home.description")} />
  </Section>
</PageLayout>
