---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { localizePath, useTranslations } from "@/i18n";

const lang = Astro.locals.lang;
const t = useTranslations(lang);
---

<BaseLayout seo={{ title: t("common.notFound.title"), noindex: true, alternates: null }}>
  <main id="main" class="mx-auto flex min-h-[70vh] max-w-page flex-col items-center justify-center px-4 text-center">
    <p class="text-sm font-semibold text-primary">404</p>
    <h1 class="mt-2 text-4xl font-bold tracking-tight">{t("common.notFound.title")}</h1>
    <p class="mt-4 text-muted-foreground">{t("common.notFound.description")}</p>
    <a href={localizePath("/", lang)} class="mt-8 rounded-md bg-primary px-5 py-2.5 font-medium text-primary-foreground">
      {t("common.backToHome")}
    </a>
  </main>
</BaseLayout>
