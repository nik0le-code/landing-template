---
import Mail from "@lucide/astro/icons/mail";
import MapPin from "@lucide/astro/icons/map-pin";
import Phone from "@lucide/astro/icons/phone";
import { siteConfig } from "@site-config";
import { footerColumns } from "@/config/navigation";
import { localizePath, useTranslations } from "@/i18n";
import { navHref } from "@/lib/nav";
import { getPublicNav } from "@/modules/registry";
import { consentBannerEnabled } from "@/lib/tracking/config";
import Container from "@/components/ui/Container.astro";
import Logo from "./Logo.astro";
import SocialLinks from "./SocialLinks.astro";
import { hasEditableSettings } from "@/lib/settings";

const lang = Astro.locals.lang;
const t = useTranslations(lang);
const { contact } = siteConfig;
const telHref = contact.phone ? `tel:${contact.phone.replace(/[^+\d]/g, "")}` : undefined;
---

<footer class="relative overflow-hidden border-t border-border bg-muted/50 [content-visibility:auto] [contain-intrinsic-size:auto_400px]">
  <!-- A single soft wash keeps the footer from reading as a grey slab. -->
  <div
    aria-hidden="true"
    class="pointer-events-none absolute inset-x-0 -top-24 h-48 bg-[radial-gradient(60rem_16rem_at_50%_0%,color-mix(in_oklch,var(--color-primary)_10%,transparent),transparent)]"
  >
  </div>
  <Container class="relative grid gap-12 py-16 sm:grid-cols-2 lg:grid-cols-[2fr_repeat(3,1fr)] lg:gap-10">
    <div class="space-y-5">
      <Logo />
      <p class="max-w-xs text-pretty text-sm text-muted-foreground">{siteConfig.description[lang]}</p>
      {
        hasEditableSettings ? (
          <SocialLinks server:defer lang={lang}>
            <SocialLinks slot="fallback" lang={lang} socials={siteConfig.socials} />
          </SocialLinks>
        ) : (
          <SocialLinks lang={lang} socials={siteConfig.socials} />
        )
      }
    </div>

    {
      footerColumns.map((column, index) => (
        <nav aria-label={t(column.title)}>
          <h2 class="text-xs font-semibold uppercase tracking-[0.12em] text-muted-foreground">{t(column.title)}</h2>
          <ul class="mt-5 space-y-3">
            {column.links.map((link) => (
              <li>
                <a href={navHref(link, lang)} class="text-sm text-foreground/75 transition-colors hover:text-primary">
                  {t(link.label)}
                </a>
              </li>
            ))}
            {index === 0 &&
              getPublicNav(lang).map((link) => (
                <li>
                  <a href={localizePath(link.path, lang)} class="text-sm text-foreground/75 transition-colors hover:text-primary">
                    {link.label}
                  </a>
                </li>
              ))}
          </ul>
        </nav>
      ))
    }

    <address class="space-y-3 text-sm not-italic text-foreground/75">
      <a href={`mailto:${contact.email}`} class="flex items-center gap-2 transition-colors hover:text-primary">
        <Mail class="size-4 shrink-0" aria-hidden="true" />{contact.email}
      </a>
      {
        telHref && (
          <a href={telHref} class="flex items-center gap-2 transition-colors hover:text-primary">
            <Phone class="size-4 shrink-0" aria-hidden="true" />
            {contact.phone}
          </a>
        )
      }
      {
        contact.address && (
          <p class="flex gap-2">
            <MapPin class="mt-0.5 size-4 shrink-0" aria-hidden="true" />
            <span>
              {contact.address.street}, {contact.address.postalCode} {contact.address.city}
            </span>
          </p>
        )
      }
    </address>
  </Container>

  <div class="relative border-t border-border/70">
    <Container class="flex flex-col gap-3 py-6 text-[0.8125rem] text-muted-foreground sm:flex-row sm:items-center sm:justify-between">
      <p>{t("footer.rights", { year: new Date().getFullYear(), name: siteConfig.organization.legalName })}</p>
      <div class="flex items-center gap-4">
        {
          consentBannerEnabled && (
            <button type="button" data-consent-open class="hover:text-foreground">
              {t("consent.settings")}
            </button>
          )
        }
        <slot name="bottom" />
      </div>
    </Container>
  </div>
</footer>
