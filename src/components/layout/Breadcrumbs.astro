---
/**
 * Visible breadcrumb trail. PageLayout also emits the matching BreadcrumbList
 * JSON-LD from the same items, so markup and schema never drift apart.
 */
import ChevronRight from "@lucide/astro/icons/chevron-right";
import type { BreadcrumbItem } from "@/lib/seo/schema";
import { useTranslations } from "@/i18n";
import { cn } from "@/lib/cn";

interface Props {
  items: BreadcrumbItem[];
  class?: string;
}

const { items, class: className } = Astro.props;
const t = useTranslations(Astro.locals.lang);
---

<nav aria-label={t("common.breadcrumbs.label")} class={cn("text-[0.8125rem] text-muted-foreground", className)}>
  <ol class="flex flex-wrap items-center gap-x-1 gap-y-1.5">
    {
      items.map((item, index) => (
        <li class="flex items-center gap-1">
          {index > 0 && <ChevronRight class="size-3.5 text-muted-foreground/50" aria-hidden="true" />}
          {item.path && index < items.length - 1 ? (
            <a
              href={item.path}
              class="rounded-sm px-1.5 py-0.5 transition-colors hover:bg-foreground/5 hover:text-foreground"
            >
              {item.name}
            </a>
          ) : (
            <span aria-current="page" class="px-1.5 py-0.5 font-medium text-foreground">
              {item.name}
            </span>
          )}
        </li>
      ))
    }
  </ol>
</nav>
