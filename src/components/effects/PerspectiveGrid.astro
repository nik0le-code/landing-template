---
/**
 * Grid receding to the horizon — an infinite 3D floor, drifting slowly. Two CSS
 * gradients on one rotated plane; no WebGL, no image.
 *
 * Works best behind a dark section: `<Section tone="dark">`.
 */
import { cn } from "@/lib/cn";

interface Props {
  /** Cell size in rem. */
  size?: number;
  /** Floor angle; 55–70deg looks like a horizon. */
  angle?: number;
  /** Seconds per cell of drift; 0 disables the movement. */
  speed?: number;
  class?: string;
}

const { size = 3, angle = 62, speed = 6, class: className } = Astro.props;
---

<div aria-hidden="true" class={cn("pointer-events-none absolute inset-0 overflow-hidden text-current/30", className)}>
  <div
    data-grid-3d
    class="absolute inset-x-[-50%] bottom-0 top-1/3"
    style={`--grid-size: ${size}rem; --grid-angle: ${angle}deg; ${speed ? `--grid-speed: ${speed}s;` : "animation: none;"}`}
  >
  </div>
</div>
