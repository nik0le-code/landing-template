---
/**
 * Light sweep across the element on hover/focus — good on a primary CTA or a
 * "featured" pricing card. Wrap, don't nest: the child keeps its own styling.
 */
import { cn } from "@/lib/cn";

interface Props {
  /** `as` is avoided on purpose: astro check mis-reports it as an unused prop. */
  tag?: "div" | "span";
  class?: string;
}

const { tag: Tag = "div", class: className } = Astro.props;
---

<Tag data-shine class={cn("relative isolate inline-flex rounded-[inherit]", className)}>
  <slot />
</Tag>
