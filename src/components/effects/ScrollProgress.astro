---
/**
 * Reading-progress bar for long pages (blog posts, legal text). Fixed to the top of
 * the viewport, driven by the document scroll timeline — zero JavaScript.
 */
import { cn } from "@/lib/cn";

interface Props {
  height?: string;
  class?: string;
}

const { height = "3px", class: className } = Astro.props;
---

<div aria-hidden="true" class="pointer-events-none fixed inset-x-0 top-0 z-50" style={`height: ${height};`}>
  <div data-scroll-progress class={cn("h-full w-full bg-primary", className)}></div>
</div>
