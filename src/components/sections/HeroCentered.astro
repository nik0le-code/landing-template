---
import Button from "@/components/ui/Button.astro";
import Badge from "@/components/ui/Badge.astro";
import Img from "@/components/ui/Img.astro";
import Section from "@/components/ui/Section.astro";
import GlowBackground from "@/components/effects/GlowBackground.astro";
import GridBackground from "@/components/effects/GridBackground.astro";
import type { CtaLink, ImageProps } from "./types";

interface Props {
  badge?: string;
  title: string;
  description?: string;
  actions?: CtaLink[];
  /** Product screenshot/visual below the copy — becomes the page's LCP image. */
  image?: ImageProps;
  background?: "grid" | "glow" | "both" | "none";
}

const { badge, title, description, actions = [], image, background = "both" } = Astro.props;
---

<Section spacing="lg" class="overflow-hidden">
  {(background === "grid" || background === "both") && <GridBackground slot="background" />}
  {(background === "glow" || background === "both") && <GlowBackground slot="background" />}
  <div class="mx-auto max-w-3xl text-center">
    {badge && <Badge class="mb-6">{badge}</Badge>}
    <h1 class="text-4xl font-bold tracking-tight text-balance sm:text-6xl">{title}</h1>
    {description && <p class="mx-auto mt-6 max-w-2xl text-lg text-pretty text-muted-foreground sm:text-xl">{description}</p>}
    {
      actions.length > 0 && (
        <div class="mt-10 flex flex-wrap items-center justify-center gap-3">
          {actions.map((action, i) => (
            <Button href={action.href} external={action.external} variant={action.variant ?? (i === 0 ? "primary" : "outline")} size="lg">
              {action.label}
            </Button>
          ))}
        </div>
      )
    }
    <slot />
  </div>
  {
    image && (
      <div class="mx-auto mt-16 max-w-5xl rounded-xl border border-border bg-card p-2 shadow-2xl shadow-primary/10">
        <Img src={image.src} alt={image.alt} priority sizes="(min-width: 1024px) 64rem, 100vw" class="w-full rounded-lg" />
      </div>
    )
  }
</Section>
