---
import Button from "@/components/ui/Button.astro";
import Img from "@/components/ui/Img.astro";
import Section from "@/components/ui/Section.astro";
import { cn } from "@/lib/cn";
import Parallax from "@/components/effects/Parallax.astro";
import type { CtaLink, ImageProps } from "./types";

interface Props {
  badge?: string;
  title: string;
  description?: string;
  actions?: CtaLink[];
  /** Product screenshot/visual below the copy — becomes the page's LCP image. */
  image?: ImageProps;
  /** Staggered rise of the copy on load (translate only, so LCP is unaffected). */
  intro?: boolean;
  /** Left-aligned reads as editorial; centred is for manifesto-style launches. */
  align?: "center" | "left";
}

const { badge, title, description, actions = [], image, intro = true, align = "center" } = Astro.props;
const centred = align === "center";
---

<Section spacing="lg" class="overflow-hidden pt-20 pb-12 sm:pt-24 sm:pb-16">
  <div class={centred ? "mx-auto max-w-4xl text-center" : "max-w-3xl"} data-intro={intro ? "" : undefined}>
    {badge && <p class="label mb-7 text-muted-foreground">{badge}</p>}
    <h1 class="text-[2.5rem] font-semibold leading-[1.05] text-balance sm:text-5xl lg:text-6xl">{title}</h1>
    {description && <p class={cn("mt-7 max-w-xl text-lg text-pretty text-muted-foreground", centred && "mx-auto")}>{description}</p>}
    {
      actions.length > 0 && (
        <div class={cn("mt-9 flex flex-wrap items-center gap-3", centred && "justify-center")}>
          {actions.map((action, i) => (
            <Button href={action.href} external={action.external} variant={action.variant ?? (i === 0 ? "primary" : "outline")} size="lg">
              {action.label}
            </Button>
          ))}
        </div>
      )
    }
    <slot />
  </div>
  {
    image && (
      /*
       * The visual sits in a device-style frame, lit from behind and faded out at
       * the bottom edge, so the section ends in a gradient instead of a hard line
       * across the page.
       */
      <Parallax distance="-1.5rem" class={cn("mt-16 border-t border-border pt-4 sm:mt-20", centred && "mx-auto max-w-5xl")}>
        <Img src={image.src} alt={image.alt} priority sizes="(min-width: 1024px) 72rem, 100vw" class="aspect-[16/9] w-full object-cover" />
      </Parallax>
    )
  }
</Section>
