---
/**
 * Responsive image grid with a no-JS lightbox (Popover API): each thumbnail opens
 * a full-size view; Escape or clicking outside closes it.
 */
import X from "@lucide/astro/icons/x";
import Img from "@/components/ui/Img.astro";
import Section from "@/components/ui/Section.astro";
import SectionHeading from "@/components/ui/SectionHeading.astro";
import Reveal from "@/components/effects/Reveal.astro";
import type { ImageSource } from "./types";

interface Props {
  id?: string;
  eyebrow?: string;
  title?: string;
  description?: string;
  images: { src: ImageSource; alt: string; caption?: string }[];
  closeLabel: string;
  tone?: "default" | "muted";
}

const { id = "gallery", eyebrow, title, description, images, closeLabel, tone = "default" } = Astro.props;
---

<Section id={id} tone={tone}>
  {title && <SectionHeading eyebrow={eyebrow} title={title} description={description} class="mb-12" />}
  <ul class="grid grid-cols-2 gap-3 sm:gap-4 lg:grid-cols-3">
    {
      images.map((image, i) => (
        <Reveal as="li" effect="fade" stagger={i % 3}>
          <button type="button" popovertarget={`${id}-image-${i}`} class="group block w-full overflow-hidden rounded-lg">
            <Img
              src={image.src}
              alt={image.alt}
              sizes="(min-width: 1024px) 33vw, 50vw"
              class="aspect-[4/3] w-full object-cover transition duration-300 group-hover:scale-105"
            />
          </button>
        </Reveal>
      ))
    }
  </ul>
  {
    images.map((image, i) => (
      <div id={`${id}-image-${i}`} popover class="m-auto max-h-[90dvh] max-w-5xl bg-transparent p-4 backdrop:bg-black/80">
        <figure class="relative">
          <Img src={image.src} alt={image.alt} sizes="90vw" class="max-h-[80dvh] w-auto rounded-lg object-contain" />
          {image.caption && <figcaption class="mt-3 text-center text-white">{image.caption}</figcaption>}
          <button
            type="button"
            popovertarget={`${id}-image-${i}`}
            popovertargetaction="hide"
            class="absolute top-2 right-2 inline-flex size-10 items-center justify-center rounded-full bg-black/60 text-white"
          >
            <X class="size-5" aria-hidden="true" />
            <span class="sr-only">{closeLabel}</span>
          </button>
        </figure>
      </div>
    ))
  }
</Section>
