---
import Card from "@/components/ui/Card.astro";
import Icon from "@/components/ui/Icon.astro";
import Section from "@/components/ui/Section.astro";
import SectionHeading from "@/components/ui/SectionHeading.astro";
import Reveal from "@/components/effects/Reveal.astro";
import { cn } from "@/lib/cn";
import type { FeatureItem } from "./types";

interface Props {
  id?: string;
  eyebrow?: string;
  title: string;
  description?: string;
  items: FeatureItem[];
  columns?: 2 | 3 | 4;
  variant?: "cards" | "plain";
  tone?: "default" | "muted";
}

const { id, eyebrow, title, description, items, columns = 3, variant = "cards", tone = "default" } = Astro.props;
const cols = { 2: "sm:grid-cols-2", 3: "sm:grid-cols-2 lg:grid-cols-3", 4: "sm:grid-cols-2 lg:grid-cols-4" };
---

<Section id={id} tone={tone}>
  <SectionHeading eyebrow={eyebrow} title={title} description={description} />
  <ul class={cn("mt-14 grid gap-6", cols[columns])}>
    {
      items.map((item, i) => (
        <Reveal as="li" stagger={i % columns}>
          <Card padding={variant === "cards" ? "md" : "none"} interactive={Boolean(item.href)} class={cn("h-full", variant === "plain" && "border-0 bg-transparent")}>
            {item.icon && (
              <span class="mb-4 inline-flex size-11 items-center justify-center rounded-md bg-primary/10 text-primary">
                <Icon name={item.icon} />
              </span>
            )}
            <h3 class="text-lg font-semibold">
              {item.href ? (
                <a href={item.href} class="after:absolute after:inset-0">
                  {item.title}
                </a>
              ) : (
                item.title
              )}
            </h3>
            <p class="mt-2 text-muted-foreground">{item.description}</p>
          </Card>
        </Reveal>
      ))
    }
  </ul>
</Section>
