---
import Img from "@/components/ui/Img.astro";
import Section from "@/components/ui/Section.astro";
import SectionHeading from "@/components/ui/SectionHeading.astro";
import SocialIcon from "@/components/layout/SocialIcon.astro";
import Reveal from "@/components/effects/Reveal.astro";
import type { ImageSource } from "./types";

export interface TeamMember {
  name: string;
  role: string;
  bio?: string;
  photo?: ImageSource;
  linkedin?: string;
}

interface Props {
  id?: string;
  eyebrow?: string;
  title: string;
  description?: string;
  members: TeamMember[];
  tone?: "default" | "muted";
}

const { id, eyebrow, title, description, members, tone = "default" } = Astro.props;
const initials = (name: string) =>
  name
    .split(/\s+/)
    .map((part) => part[0])
    .slice(0, 2)
    .join("");
---

<Section id={id} tone={tone}>
  <SectionHeading eyebrow={eyebrow} title={title} description={description} />
  <ul class="mt-14 grid gap-10 sm:grid-cols-2 lg:grid-cols-4">
    {
      members.map((member, i) => (
        <Reveal as="li" stagger={i % 4} class="text-center">
          {member.photo ? (
            <Img src={member.photo} alt={member.name} width={320} height={320} class="mx-auto aspect-square w-40 object-cover" />
          ) : (
            <span
              class="mx-auto grid aspect-square w-40 place-items-center border border-border bg-muted font-mono text-2xl text-muted-foreground"
              aria-hidden="true"
            >
              {initials(member.name)}
            </span>
          )}
          <h3 class="mt-5 text-lg font-semibold">{member.name}</h3>
          <p class="text-sm text-primary">{member.role}</p>
          {member.bio && <p class="mt-3 text-sm text-muted-foreground">{member.bio}</p>}
          {member.linkedin && (
            <a href={member.linkedin} target="_blank" rel="noopener noreferrer" class="mt-3 inline-flex text-muted-foreground hover:text-foreground">
              <SocialIcon network="linkedin" class="size-4" />
              <span class="sr-only">LinkedIn: {member.name}</span>
            </a>
          )}
        </Reveal>
      ))
    }
  </ul>
</Section>
