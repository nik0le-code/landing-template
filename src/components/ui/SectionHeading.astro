---
import { cn } from "@/lib/cn";

interface Props {
  eyebrow?: string;
  title: string;
  description?: string;
  align?: "left" | "center";
  /** Use h1 only for the single main heading of a page. */
  tag?: "h1" | "h2" | "h3";
  class?: string;
}

const { eyebrow, title, description, align = "center", tag: Tag = "h2", class: className } = Astro.props;
const headingSize = Tag === "h1" ? "text-4xl sm:text-5xl lg:text-6xl" : "text-[1.75rem] sm:text-4xl lg:text-[2.5rem] lg:leading-[1.08]";
---

<div class={cn("max-w-2xl", align === "center" && "mx-auto text-center [&>p]:mx-auto", className)}>
  {eyebrow && <p class="label text-muted-foreground">{eyebrow}</p>}
  <Tag class={cn("font-medium text-balance", headingSize, eyebrow && "mt-5")}>{title}</Tag>
  {description && <p class="mt-4 max-w-xl text-pretty text-muted-foreground">{description}</p>}
  <slot />
</div>
