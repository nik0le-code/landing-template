---
/**
 * Typography for long-form HTML (legal pages, blog posts) without pulling in the
 * typography plugin. Styles live in src/styles/prose.css so React islands (editor
 * preview) can use `class="prose"` too.
 */
import { cn } from "@/lib/cn";

interface Props {
  class?: string;
}
---

<div class={cn("prose", Astro.props.class)}><slot /></div>
