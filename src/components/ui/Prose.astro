---
/**
 * Typography for long-form HTML (legal pages, blog posts) without pulling in the
 * typography plugin: styles only descendants of this wrapper.
 */
import { cn } from "@/lib/cn";

interface Props {
  class?: string;
}
---

<div class={cn("prose", Astro.props.class)}><slot /></div>

<style>
  .prose {
    max-width: 70ch;
    line-height: 1.75;
    color: var(--color-foreground);
  }
  .prose :global(:where(h2)) {
    margin: 2.25em 0 0.75em;
    font-size: 1.5rem;
    font-weight: 700;
    line-height: 1.3;
  }
  .prose :global(:where(h3)) {
    margin: 1.75em 0 0.5em;
    font-size: 1.25rem;
    font-weight: 600;
  }
  .prose :global(:where(p, ul, ol, blockquote, pre, table, figure)) {
    margin: 1.25em 0;
  }
  .prose :global(:where(ul)) {
    list-style: disc;
    padding-left: 1.5em;
  }
  .prose :global(:where(ol)) {
    list-style: decimal;
    padding-left: 1.5em;
  }
  .prose :global(:where(li)) {
    margin: 0.4em 0;
  }
  .prose :global(:where(a)) {
    color: var(--color-primary);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .prose :global(:where(strong)) {
    font-weight: 600;
  }
  .prose :global(:where(blockquote)) {
    border-left: 3px solid var(--color-border);
    padding-left: 1em;
    color: var(--color-muted-foreground);
    font-style: italic;
  }
  .prose :global(:where(code)) {
    border-radius: var(--radius-sm);
    background: var(--color-muted);
    padding: 0.15em 0.35em;
    font-size: 0.9em;
  }
  .prose :global(:where(pre)) {
    overflow-x: auto;
    border-radius: var(--radius-md);
    background: var(--color-foreground);
    color: var(--color-background);
    padding: 1em;
  }
  .prose :global(:where(pre code)) {
    background: none;
    padding: 0;
  }
  .prose :global(:where(img)) {
    border-radius: var(--radius-md);
  }
  .prose :global(:where(hr)) {
    margin: 2.5em 0;
    border-color: var(--color-border);
  }
  .prose :global(:where(table)) {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.95em;
  }
  .prose :global(:where(th, td)) {
    border-bottom: 1px solid var(--color-border);
    padding: 0.5em;
    text-align: left;
  }
  .prose > :global(:first-child) {
    margin-top: 0;
  }
</style>
