---
/**
 * One image component for every source:
 * - imported assets (`import hero from "@/assets/hero.jpg"`) → optimized <picture>
 *   with AVIF/WebP, responsive srcset and intrinsic size (no layout shift);
 * - imported SVGs → served as-is (vector; rasterizing would only add bytes);
 * - string URLs (uploaded media, remote) → plain <img> with lazy loading.
 *
 * Set `priority` on the single above-the-fold (LCP) image of a page.
 */
import type { ImageMetadata } from "astro";
import { Picture } from "astro:assets";

interface Props {
  src: ImageMetadata | string;
  alt: string;
  width?: number;
  height?: number;
  /** Rendered size hint, e.g. "(min-width: 1024px) 50vw, 100vw". */
  sizes?: string;
  priority?: boolean;
  class?: string;
  layout?: "constrained" | "full-width" | "fixed";
}

const { src, alt, width, height, sizes, priority = false, class: className, layout = "constrained" } = Astro.props;

const isSvg = typeof src !== "string" && src.format === "svg";
const plain =
  typeof src === "string"
    ? { src, width, height }
    : isSvg
      ? {
          src: src.src,
          width: width ?? (height ? Math.round((height * src.width) / src.height) : src.width),
          height: height ?? (width ? Math.round((width * src.height) / src.width) : src.height),
        }
      : null;
---

{
  plain ? (
    <img
      src={plain.src}
      alt={alt}
      width={plain.width}
      height={plain.height}
      sizes={sizes}
      class={className}
      loading={priority ? "eager" : "lazy"}
      fetchpriority={priority ? "high" : "auto"}
      decoding="async"
    />
  ) : (
    <Picture
      src={src as ImageMetadata}
      alt={alt}
      formats={["avif", "webp"]}
      width={width}
      height={height}
      sizes={sizes}
      layout={layout}
      priority={priority}
      class={className}
    />
  )
}
