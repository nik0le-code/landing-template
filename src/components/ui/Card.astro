---
import type { HTMLAttributes } from "astro/types";
import { cn } from "@/lib/cn";

interface Props extends HTMLAttributes<"div"> {
  as?: "div" | "article" | "li";
  /** Adds hover lift; use when the whole card is a link. */
  interactive?: boolean;
  padding?: "none" | "sm" | "md" | "lg";
}

const { as: Tag = "div", interactive = false, padding = "md", class: className, ...rest } = Astro.props;
const paddings = { none: "", sm: "p-4", md: "p-6", lg: "p-8" };
---

<Tag
  class={cn(
    "relative rounded-lg border border-border bg-card text-card-foreground",
    paddings[padding],
    interactive && "transition hover:-translate-y-0.5 hover:border-primary/40 hover:shadow-lg",
    className,
  )}
  {...rest}
>
  <slot />
</Tag>
