---
import type { HTMLAttributes } from "astro/types";
import { cn } from "@/lib/cn";
import { inputClasses } from "./variants";

interface Props extends HTMLAttributes<"input"> {
  id: string;
  invalid?: boolean;
}

const { id, invalid = false, class: className, ...rest } = Astro.props;
const describedBy = `${id}-hint ${id}-error`;
---

<input id={id} class={cn(inputClasses, className)} aria-describedby={describedBy} aria-invalid={invalid ? "true" : undefined} {...rest} />
