---
/**
 * Vertical rhythm + background for page sections. Content goes through a Container.
 */
import type { HTMLAttributes } from "astro/types";
import { cn } from "@/lib/cn";
import Container from "./Container.astro";

interface Props extends HTMLAttributes<"section"> {
  tone?: "default" | "muted" | "primary" | "dark";
  spacing?: "none" | "sm" | "md" | "lg";
  width?: "sm" | "md" | "page";
  /**
   * `content-visibility: auto` — the browser skips rendering the section until it
   * nears the viewport. Big win for long pages on low-end phones, but it makes
   * in-page anchor jumps (#pricing) land imprecisely, so it's opt-in: use it on
   * heavy sections nobody links to directly.
   */
  lazyRender?: boolean;
}

const {
  tone = "default",
  spacing = "md",
  width = "page",
  lazyRender = false,
  class: className,
  ...rest
} = Astro.props;

const tones = {
  default: "bg-background text-foreground",
  muted: "bg-muted text-foreground",
  primary: "bg-brand-surface text-brand-surface-foreground",
  dark: "bg-contrast text-contrast-foreground",
};
const spacings = { none: "", sm: "py-14 sm:py-20", md: "py-20 sm:py-28", lg: "py-24 sm:py-36" };
---

<section
  class={cn(
    "relative",
    tones[tone],
    spacings[spacing],
    lazyRender && "[content-visibility:auto] [contain-intrinsic-size:auto_800px]",
    className,
  )}
  {...rest}
>
  <slot name="background" />
  <Container size={width} class="relative">
    <slot />
  </Container>
</section>
