---
/**
 * Cookie consent banner (vanilla JS, no framework). Shown until the visitor
 * chooses; "Reject all" is exactly as prominent as "Accept all", as the Greek
 * DPA and EDPB guidance require. Any element with `data-consent-open` reopens it
 * (the footer has a "Cookie settings" button).
 *
 * Render it only when `consentBannerEnabled` (BaseLayout does).
 */
import { localizePath, useTranslations } from "@/i18n";
import { consentCategories } from "@/lib/tracking/config";
import { buttonClasses } from "@/components/ui/variants";

const lang = Astro.locals.lang;
const t = useTranslations(lang);
---

<section
  id="consent-banner"
  role="dialog"
  aria-modal="false"
  aria-labelledby="consent-title"
  aria-describedby="consent-description"
  hidden
  class="fixed inset-x-3 bottom-3 z-50 max-h-[calc(100dvh-1.5rem)] overflow-y-auto rounded-xl border border-border bg-card p-5 text-card-foreground shadow-2xl sm:right-auto sm:left-4 sm:bottom-4 sm:max-w-md"
>
  <h2 id="consent-title" tabindex="-1" class="text-base font-semibold outline-none">
    {t("consent.title")}
  </h2>
  <p id="consent-description" class="mt-2 text-sm text-muted-foreground">
    {t("consent.description")}{" "}
    <a href={localizePath("/privacy", lang)} class="font-medium text-foreground underline underline-offset-2">
      {t("consent.policy")}
    </a>
  </p>

  <fieldset data-consent-details hidden class="mt-4 space-y-3 border-t border-border pt-4">
    <legend class="sr-only">{t("consent.customize")}</legend>
    <div class="flex items-start justify-between gap-4">
      <div>
        <p class="text-sm font-medium">{t("consent.categories.necessary.title")}</p>
        <p class="text-xs text-muted-foreground">{t("consent.categories.necessary.description")}</p>
      </div>
      <span class="shrink-0 text-xs font-medium text-muted-foreground">{t("consent.alwaysOn")}</span>
    </div>
    {consentCategories.map((category) => (
      <label class="flex cursor-pointer items-start justify-between gap-4">
        <span>
          <span class="block text-sm font-medium">{t(`consent.categories.${category}.title`)}</span>
          <span class="block text-xs text-muted-foreground">{t(`consent.categories.${category}.description`)}</span>
        </span>
        <input type="checkbox" name={category} class="mt-1 size-4 shrink-0 accent-primary" />
      </label>
    ))}
  </fieldset>

  <div class="mt-5 grid grid-cols-2 gap-2">
    <button type="button" data-consent="reject" class={buttonClasses("primary", "sm")}>
      {t("consent.rejectAll")}
    </button>
    <button type="button" data-consent="accept" class={buttonClasses("primary", "sm")}>
      {t("consent.acceptAll")}
    </button>
    <button type="button" data-consent="customize" class={buttonClasses("ghost", "sm", "col-span-2")}>
      {t("consent.customize")}
    </button>
    <button type="button" data-consent="save" hidden class={buttonClasses("outline", "sm", "col-span-2")}>
      {t("consent.save")}
    </button>
  </div>
</section>

<script>
  const banner = document.getElementById("consent-banner");
  const consent = window.siteConsent;

  if (banner && consent) {
    const details = banner.querySelector<HTMLFieldSetElement>("[data-consent-details]")!;
    const customizeButton = banner.querySelector<HTMLButtonElement>('[data-consent="customize"]')!;
    const saveButton = banner.querySelector<HTMLButtonElement>('[data-consent="save"]')!;
    const checkbox = (name: string) => banner.querySelector<HTMLInputElement>(`input[name="${name}"]`);

    const showDetails = (show: boolean) => {
      details.hidden = !show;
      customizeButton.hidden = show;
      saveButton.hidden = !show;
    };

    const open = (withDetails: boolean) => {
      const current = consent.get();
      for (const name of ["analytics", "marketing"] as const) {
        const input = checkbox(name);
        if (input) input.checked = current?.[name] ?? false;
      }
      showDetails(withDetails);
      banner.hidden = false;
      if (withDetails) banner.querySelector<HTMLElement>("#consent-title")?.focus();
    };

    const choose = (analytics: boolean, marketing: boolean) => {
      consent.set({ analytics, marketing });
      banner.hidden = true;
    };

    banner.addEventListener("click", (event) => {
      const action = (event.target as Element).closest<HTMLElement>("[data-consent]")?.dataset.consent;
      if (action === "accept") choose(true, true);
      else if (action === "reject") choose(false, false);
      else if (action === "customize") showDetails(true);
      else if (action === "save") choose(Boolean(checkbox("analytics")?.checked), Boolean(checkbox("marketing")?.checked));
    });

    document.addEventListener("click", (event) => {
      if ((event.target as Element).closest("[data-consent-open]")) open(true);
    });

    if (consent.required && !consent.get()) open(false);
  }
</script>
