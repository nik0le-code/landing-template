---
/**
 * Standard public page: skip link, optional announcement, navbar, <main>, footer.
 *
 * ```astro
 * <PageLayout seo={{ title: t("meta.about.title") }} breadcrumbs={[…]}>
 *   <Hero … />
 * </PageLayout>
 * ```
 */
import type { Locale } from "@site-config";
import type { SeoProps } from "@/components/seo/Seo.astro";
import { localeAlternates, localizePath, useTranslations } from "@/i18n";
import { breadcrumbSchema, type BreadcrumbItem } from "@/lib/seo/schema";
import AnnouncementBar from "@/components/layout/AnnouncementBar.astro";
import AnnouncementBanner from "@/components/layout/AnnouncementBanner.astro";
import { hasEditableSettings } from "@/lib/settings";
import Breadcrumbs from "@/components/layout/Breadcrumbs.astro";
import Container from "@/components/ui/Container.astro";
import Footer from "@/components/layout/Footer.astro";
import Navbar from "@/components/layout/Navbar.astro";
import SkipLink from "@/components/layout/SkipLink.astro";
import ModuleSlot from "@/components/modules/ModuleSlot.astro";
import BaseLayout from "./BaseLayout.astro";

interface Props {
  seo: SeoProps;
  schema?: Record<string, unknown>[];
  /**
   * Trail after "Home" (added automatically). The last item is the current page.
   * Rendered visually and as BreadcrumbList JSON-LD.
   */
  breadcrumbs?: BreadcrumbItem[];
  announcement?: { text: string; href?: string; linkText?: string };
}

const { seo, schema = [], breadcrumbs, announcement } = Astro.props;
const lang = Astro.locals.lang;
const t = useTranslations(lang);

// Pages with per-locale slugs pass `seo.alternates`; the switcher uses the same map.
const alternates: Partial<Record<Locale, string>> =
  seo.alternates === null ? { [lang]: Astro.url.pathname } : (seo.alternates ?? localeAlternates(Astro.url.pathname));

const trail = breadcrumbs ? [{ name: t("common.home"), path: localizePath("/", lang) }, ...breadcrumbs] : undefined;
const pageSchema = trail ? [...schema, breadcrumbSchema(trail)] : schema;
---

<BaseLayout seo={seo} schema={pageSchema}>
  <slot name="head" slot="head" />
  <SkipLink />
  {announcement && <AnnouncementBar {...announcement} />}
  <Navbar alternates={alternates} />
  <main id="main" tabindex="-1" class="outline-none">
    {
      /*
       * The trail overlaps the top padding of the first section instead of sitting
       * in a band of its own, so it always shares that section's background
       * (muted, dark, aurora) rather than cutting a strip of page background
       * across the top of the page.
       */
      trail && (
        <Container class="relative z-10 -mb-10 pt-5 sm:-mb-12 sm:pt-7">
          <Breadcrumbs items={trail} />
        </Container>
      )
    }
    <slot />
    <ModuleSlot name="layout.beforeFooter" />
  </main>
  <Footer />
  {hasEditableSettings && <AnnouncementBanner server:defer lang={lang} />}
</BaseLayout>
